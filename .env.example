# Copy to .env.local and fill in. NEVER commit real values.
# On Vercel: Project → Settings → Environment Variables (same names).

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, never expose

# Only for running migrations/scripts from your computer (not needed on Vercel).
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Public address (emails, payment callbacks). Leave unset on Vercel to auto-detect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@yourdomain.co.ke

# Protects /api/cron/* (Vercel sends it automatically)
CRON_SECRET=

# --- M-Pesa Daraja (STK Push). MPESA_ENV = sandbox | production | simulate (local only)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=                                  # Till number when using Buy Goods
MPESA_CALLBACK_SECRET=                          # long random string
# MPESA_CALLBACK_BASE_URL=                      # e.g. an ngrok URL when testing locally

# --- Paystack (cards, KES)
PAYSTACK_SECRET_KEY=

# --- Notifications
RESEND_API_KEY=
EMAIL_FROM="MamaTerryCollections <orders@yourdomain.co.ke>"
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Android app (Trusted Web Activity / Google Play)
ANDROID_PACKAGE_NAME=ke.co.mamaterrycollections.app
ANDROID_SHA256_FINGERPRINTS=     # comma-separated, from Play Console → App integrity
